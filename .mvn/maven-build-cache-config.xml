<?xml version="1.0" encoding="UTF-8"?>
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.4.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.4.0 https://maven.apache.org/xsd/build-cache-config-1.4.0.xsd">

    <configuration>
        <enabled>true</enabled>
        <hashAlgorithm>XX</hashAlgorithm>
        <validateXml>true</validateXml>
        <local>
            <!-- Bounds how many historical entries per module accumulate in the persisted
                 cache directory across CI runs, independent of GitHub Actions' own cache eviction. -->
            <maxBuildsCached>10</maxBuildsCached>
        </local>
    </configuration>

    <input>
        <global>
            <!-- No <glob> override: several modules register services via extensionless
                 ServiceLoader/Spring factories files under META-INF (e.g. META-INF/services/*),
                 so the default "*" glob is kept to avoid silently excluding them from the
                 input hash, which would let a changed SPI registration go undetected by the cache. -->
            <excludes>
                <!-- pom.xml changes are already accounted for via the extension's effective-POM
                     handling; hashing the raw file too is redundant and template-recommended
                     to exclude. -->
                <exclude>pom.xml</exclude>
            </excludes>
        </global>
    </input>

    <!--
         The `deploy` step in CI is a second Maven invocation, after `clean verify` has already
         populated the cache in the same run, so every module is a cache hit and the extension
         skips its mojos ("Skipping plugin execution (cached): flatten:flatten"). That skip also
         skips flatten's `updatePomFile`, which is what substitutes the flattened POM for the
         raw one, so the POM that gets deployed still carries the literal `${revision}` in its
         parent version — unresolvable for any consumer. Flattening is cheap and its output is
         what we publish, so it always runs, cached or not.
    -->
    <executionControl>
        <runAlways>
            <plugins>
                <plugin artifactId="flatten-maven-plugin"/>
            </plugins>
        </runAlways>
    </executionControl>

</cache>
