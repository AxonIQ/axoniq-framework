<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="axonSpringTest" transaction-type="RESOURCE_LOCAL">
        <class>org.axonframework.eventsourcing.eventstore.jpa.AggregateEventEntry</class>
        <class>org.axonframework.messaging.jpa.eventstore.eventsourcing.SnapshotEventEntry</class>
        <class>org.axonframework.modelling.saga.repository.jpa.AssociationValueEntry</class>
        <class>org.axonframework.modelling.saga.repository.jpa.SagaEntry</class>
        <class>org.axonframework.messaging.jpa.deadletter.eventhandling.DeadLetterEntry</class>
        <class>org.axonframework.messaging.jpa.deadletter.eventhandling.DeadLetterEventEntry</class>
        <class>org.axonframework.spring.modeling.command.JpaAggregate</class>
        <properties>
            <property name="hibernate.archive.autodetection" value="class"/>
        </properties>
    </persistence-unit>
</persistence>