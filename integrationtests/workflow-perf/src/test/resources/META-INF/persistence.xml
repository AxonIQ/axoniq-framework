<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- The token store and the workflow index of the load test. The data source is passed in by the test. -->
    <persistence-unit name="workflow-perf" transaction-type="RESOURCE_LOCAL">
        <class>io.axoniq.framework.workflow.index.jpa.WorkflowIndexEntry</class>
        <class>io.axoniq.framework.workflow.index.jpa.WorkflowIndexWaitEntry</class>
        <class>io.axoniq.framework.workflow.index.jpa.WorkflowIndexSegmentEntry</class>
        <class>org.axonframework.messaging.eventhandling.processing.streaming.token.store.jpa.TokenEntry</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
        </properties>
    </persistence-unit>
</persistence>
