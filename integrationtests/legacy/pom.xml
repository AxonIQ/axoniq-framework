<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.axoniq.framework</groupId>
        <artifactId>axoniq-integrationtests</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>axoniq-integrationtests-legacy</artifactId>

    <name>Axoniq Framework - Integration Tests - Legacy</name>
    <description>
        Module containing integration tests for the legacy support layer.
    </description>

    <dependencies>
        <!-- Axon Dependencies -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-messaging</artifactId>
            <version>${axon-framework.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!--
           Verifies that the Axon Framework 4 saga stores take part in a transaction driven by a unit of work. This is
           the module that can depend on both axoniq-legacy and the Spring extension, which is what makes the JDBC side
           testable against the real SpringTransactionManager.
       -->
        <dependency>
            <groupId>io.axoniq.framework</groupId>
            <artifactId>axoniq-legacy</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- For the StubSaga fixture, rather than duplicating it here. -->
        <dependency>
            <groupId>io.axoniq.framework</groupId>
            <artifactId>axoniq-legacy</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.axonframework.extensions.spring</groupId>
            <artifactId>axon-spring</artifactId>
            <version>${axon-framework.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hsqldb</groupId>
            <artifactId>hsqldb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven-jar.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <phase>package</phase>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>
</project>
