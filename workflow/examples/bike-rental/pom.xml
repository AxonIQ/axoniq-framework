        <dependency>
            <groupId>org.axonframework.extensions.spring</groupId>
            <artifactId>axon-spring-boot-starter</artifactId>
        </dependency>
        <!--
        <dependency>
            <groupId>org.axonframework.extensions.spring</groupId>
            <artifactId>axon-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        -->
        <!-- Workflow -->
        <dependency>
            <groupId>io.axoniq.framework.workflow</groupId>
            <artifactId>axon-workflow-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.axoniq.framework.workflow</groupId>
            <artifactId>axon-workflow-dsl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.axoniq.framework.workflow</groupId>
            <artifactId>axon-workflow-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
