<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Set all org.axonframework loggers to INFO level -->
    <logger name="org.axonframework" level="INFO"/>
    <logger name="org.axonframework.messaging.eventhandling.processing.streaming.pooled" level="INFO"/>
    <logger name="io.axoniq.workflow.runtime.engine.impl.taskqueue" level="TRACE"/>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>