<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="TreeWalker">
        <!-- Enforce JSpecify as the single nullness annotation system. -->
        <!-- TODO as part of #115 activate those -->
        <!--
        <module name="IllegalImport">
            <property name="illegalClasses"
                      value="jakarta.annotation.Nonnull,
                             jakarta.annotation.Nullable,
                             org.jetbrains.annotations.NotNull,
                             org.jetbrains.annotations.Nullable,
                             org.springframework.lang.NonNull"
            />
        </module>
        -->
        <module name="RegexpSinglelineJava">
            <property name="format"
                      value="import\s+static\s+org\.junit\.jupiter\.api\.Assertions\..*"/>
            <property name="message"
                      value="Use AssertJ instead of JUnit Assertions"/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="System\.out"/>
        <property name="message" value="Use Logger instead of System.out."/>
    </module>
</module>
